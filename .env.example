
# Copy this file to .env and fill in what you need.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional but strongly recommended once this is reachable by anyone but you.
# If unset, Sia runs with NO auth — anyone with the URL can chat on your key
# and, more importantly, use device control.
SIA_PASSWORD=

# Optional — a dedicated signing secret for auth/session cookies. Falls back
# to a value derived from SIA_PASSWORD if unset.
SESSION_SECRET=

PORT=3000

# Optional, shown to OpenRouter for analytics, not required
APP_URL=http://localhost:3000

# --- Voice (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Device Control: sandboxed file actions (optional) ---
# Folder Sia's file read/write/move/delete actions are confined to. Defaults
# to data/device/files inside the project if unset. Every path is resolved
# and checked against this root — nothing outside it is reachable.
SIA_DEVICE_ROOT=

# --- Device Control: WhatsApp messaging (optional) ---
# Uses Twilio's official WhatsApp Business API — no QR pairing, no
# unofficial personal-account automation. Get these from twilio.com/console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Device Control: phone calls (optional) ---
# A Twilio phone number you own, used as the caller ID for place_call.
TWILIO_CALLER_NUMBER=

# --- Device Control: Instagram messaging (optional) ---
# Meta's official Instagram Messaging API. Requires an Instagram
# Business/Creator account linked to a Facebook Page, and a Meta app with
# instagram_manage_messages permission. There's no supported way to
# automate a personal Instagram account and this project doesn't try to.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Voice loop: wake word + speech-to-text (optional) ---
# Free key + custom "Hey Sia" wake-word (.ppn) file from https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=
PICOVOICE_KEYWORD_PATH=
# Pick ONE for transcription — Groq is much faster for a voice loop.
GROQ_API_KEY=
OPENAI_API_KEY=
# sessionId the standalone voice loop (and your Android app pairing) use.
VOICE_SESSION_ID=voice-loop

# --- Android companion app pairing (optional) ---
# Any long random string — set here and paste into the app's pairing screen.
ANDROID_PAIR_TOKEN=
